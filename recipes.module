/**
 * Implements hook_theme_registry_alter().
 */
function recipes_theme_registry_alter(&$theme_registry) {
  $theme_registry['confirm_form']['attached']['css'][backdrop_get_path('module', 'recipes') . '/css/recipes.admin.css'] = array();
}

/**
 * Magic loader: Loads recipe information by its signature. If the signature
 * starts with 'rollback|', it indicates a rollback recipe and is loaded from
 * the rollback configuration.
 *
 * @param $signature
 *   The unique signature of the recipe to load.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info(), or an empty array if not provided.
 *
 * @return array|bool
 *   The recipe information, or FALSE if not found.
 */
function recipes_load(string $signature, array $system_info = array()) {
  if (strpos($signature, 'rollback|') === 0) {
    return recipes_rollback_load($signature, $system_info);
  }
  $recipe = recipes_load_multiple(array($signature), $system_info);
  return $recipe[$signature] ?? FALSE;
}

/**
 * Discover all recipes from enabled themes and modules.
 *
 * @param array $requested_recipes
 *   An optional array of recipes to load. If empty, all recipes will be loaded.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info(), or an empty array if not provided.
 *
 * @return array
 *   An array of all available or requested recipes. Keyed by the signature
 *   "project-type:project-name:name", each entry contains the following
 *   keys:
 *   - project-type: The type of project (e.g., module, theme).
 *   - project-name: The name of the project.
 *   - name: The name of the recipe.
 *   - path: The path to the template file relative to the Backdrop root.
 *   - status: The status of the recipe (e.g., available, unavailable, changed).
 *   - signature: The unique signature of the recipe, typically in the format
 *     "project-type:project-name:name".
 */
function recipes_load_multiple(array $requested_recipes = array(), array $system_info = array()) {
  $recipes = &backdrop_static(__FUNCTION__, array());
  if (empty($recipes)) {
    $recipe_config_keys = array(
      'name',
      'version',
      'label',
      'description',
      'project-type',
      'project-name',
      'group',
      'dependencies',
      'overrides',
    );
    // Initialize system info.
    if (empty($system_info)) {
      $system_info = _recipes_get_system_info();
    }
    $paths = array();
    foreach ($system_info['module'] as $module_name => $module) {
      if (!empty($module->status)) {
        $paths['module'][$module_name] = backdrop_get_path('module', $module_name);
      }
    }
    foreach ($system_info['theme'] as $theme) {
      if (!empty($theme->status)) {
        $paths['theme'][$theme->name] = backdrop_get_path('theme', $theme->name);
      }
    }
    foreach ($paths as $project_type => $path_list) {
      foreach ($path_list as $project_name => $path) {
        if (is_dir($path)) {
          if (is_dir($path . '/recipes')) {
            // Scan directory for recipe directories.
            $recipe_dirs = scandir($path . '/recipes');
            foreach ($recipe_dirs as $recipe_name) {
              $recipe_path = $path . '/recipes/' . $recipe_name;
              if ($recipe_name === '.' || $recipe_name === '..') {
                continue;
              }
              if (is_file($recipe_path . '/' . $recipe_name . '.json')) {
                $signature = $project_type . ':' . $project_name . ':' . $recipe_name;
                $recipe_config = json_decode(file_get_contents($recipe_path . '/' . $recipe_name . '.json'), TRUE);
                // Basic validation of recipe definition.
                if (empty($recipe_config) || !is_array($recipe_config)) {
                  continue;
                }
                if ($project_type !== $recipe_config['project-type'] || $project_name !== $recipe_config['project-name']) {
                  continue;
                }
                if (empty($recipe_config['project-name']) || empty($recipe_config['project-type']) || empty($recipe_config['name'])) {
                  continue;
                }
                foreach ($recipe_config_keys as $setting_name) {
                  $recipes[$signature][$setting_name] = $recipe_config[$setting_name] ?? NULL;
                }
                $recipes[$signature] += array(
                  'signature' => $signature,
                  'path' => $recipe_path,
                );
              }
            }
          }
        }
      }
    }
    $system_info['recipe'] = $recipes;
    foreach ($recipes as $signature => $implementation) {
      // $recipes[$signature]['status'] = recipes_get_status($implementation);
    }
  }
  if (!empty($requested_recipes)) {
    // Return only the recipes that are in the $requested_recipes array.
    $filtered_recipes = array();
    foreach ($requested_recipes as $requested_recipe) {
      if (isset($recipes[$requested_recipe])) {
        $filtered_recipes[$requested_recipe] = $recipes[$requested_recipe];
      }
    }
    return $filtered_recipes;
  }
  else {
    return $recipes;
  }
}

/**
 * Load a saved rollback recipe.
 *
 * @param $signature
 *   The unique signature of the recipe to load from rollback config.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info(), or an empty array if not provided.
 *
 * @return array|bool
 *   The recipe information, or FALSE if not found.
 */
function recipes_rollback_load(string $signature, array $system_info = array()) {
  $recipe = array();
  $rollback_config_name = substr($signature, strlen('rollback|'));
  $rollback_config_name = 'recipes.rollback.' . str_replace(':', '.', $rollback_config_name);
  $rollback_recipe = config($rollback_config_name)->get();
  $recipe[$signature] = $rollback_recipe ?? FALSE;
  return $recipe[$signature];
}

/**
 * Gather and check dependencies for a particular recipe, returning the current
 * status of the recipe.
 *
 * @param string $signature
 *   The recipe signature.
 *
 * @return array
 *   The status of this recipe based on all dependencies (including nested
 *   dependencies) and any bundled config. Valid status results:
 *     - RECIPES_STATUS_INSTALLED: The recipe is already installed and config
 *       matches.
 *     - RECIPES_STATUS_CHANGED: The recipe is installed but its configuration
 *       has changed.
 *     - RECIPES_STATUS_AVAILABLE: All dependencies are met and the recipe can
 *       be installed.
 *     - RECIPES_STATUS_UNAVAILABLE: Not installed and some dependencies are
 *       missing or broken.
 */
function recipes_get_status(string $signature) {
  $status = &backdrop_static(__FUNCTION__ . ':' . $signature, array());
  if (!empty($status)) {
    return $status;
  }
  $recipe = recipes_load($signature);
  if (empty($recipe)) {
    return array(
      'key' => RECIPES_STATUS_UNAVAILABLE,
      'messages' => array(t('Recipe not found.')),
    );
  }
  $status = array(
    'key' => RECIPES_STATUS_AVAILABLE,
    'messages' => array(),
  );
  $status = array(
    'key' => RECIPES_STATUS_AVAILABLE,
    'messages' => array(),
  );
  $recipe_is_active = recipes_is_active($signature);
  // Check if the recipe is installed.
  if ($recipe_is_active) {
    $status['key'] = RECIPES_STATUS_INSTALLED;
    $recipe_installed = TRUE;
  }
  else {
    $recipe_installed = FALSE;
  }
  // Check if any bundled configuration has changed.
  $config_status = _recipes_do('check', 'config', $signature);
  // Check dependencies of the recipe.
  $dependencies_status = _recipes_do('check', 'dependencies', $signature);

  // Check config and state overrides.
  $overrides_status = _recipes_do('check', 'overrides', $signature);

  // Compile status results.
  $status_results = array(
    $config_status['key'],
    $dependencies_status['key'],
    $overrides_status['key'],
    $status['key'],
  );
  // Determine the highest priority status.
  if (in_array(RECIPES_STATUS_UNAVAILABLE, $status_results)) {
    $status['key'] = RECIPES_STATUS_UNAVAILABLE;
  }
  elseif (in_array(RECIPES_STATUS_CHANGED, $status_results) && $recipe_is_active) {
    $status['key'] = RECIPES_STATUS_CHANGED;
  }
  elseif (in_array(RECIPES_STATUS_INSTALLED, $status_results) && $recipe_is_active) {
    $status['key'] = RECIPES_STATUS_INSTALLED;
  }
  else {
    $status['key'] = RECIPES_STATUS_AVAILABLE;
  }
  $status['messages'] = array_merge(
    $config_status['messages'] ?? array(),
    $dependencies_status['messages'] ?? array(),
    $overrides_status['messages'] ?? array()
  );
  return $status;
}

/**
 * Apply a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to apply.
 * @param bool $force
 *   Whether to force apply the recipe, overwriting existing configuration if
 *   needed.
 */
function recipes_apply_recipe(string $signature, bool $force = FALSE) {
  $status = recipes_get_status($signature);
  // Bail out if the dependencies are not met.
  if ($status['key'] === RECIPES_STATUS_UNAVAILABLE) {
    backdrop_set_message(t('The <em>%recipe</em> recipe cannot be applied at the moment, please review the dependencies.', array('%recipe' => $signature)), 'error');
    backdrop_goto('admin/structure/recipes');
  }

  $recipe = recipes_load($signature);
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $signature);
  $rollback_recipe = array(
    'name' => $rollback_name,
    'label' => 'Rollback recipe for ' . $signature,
    'generated' => date('Y-m-d H:i:s'),
    'signature' => $recipe['signature'] ? 'rollback|' . $recipe['signature'] : '',
    'path' => $recipe['path'] ?? '',
    'config' => array(),
    'dependencies' => array(),
    'overrides' => array(),
  );
  // Apply dependencies.
  $rollback_recipe['dependencies'] += _recipes_do('apply', 'dependencies', $recipe['signature']);

  // Import the fresh configuration provided by the recipe.
  if (!$force) {
    $rollback_recipe['config'] += _recipes_do('apply', 'config', $signature);
  }
  else {
    $rollback_recipe['config'] += _recipes_apply__config($signature, _recipes_get_system_info(), $force);
  }

  // Finally, apply configuration overrides if any.
  $rollback_recipe['overrides'] += _recipes_do('apply', 'overrides', $signature);

  recipes_mark_active($signature);
  if (!empty($rollback_recipe['config']) || !empty($rollback_recipe['dependencies']) || !empty($rollback_recipe['overrides'])) {
    $rollback_config = config($rollback_name);
    $rollback_config->setData($rollback_recipe);
    $rollback_config->save();
  }

  // Set a message.
  $message = 'The <em>%recipe</em> has been applied to this site.';
  $replacements = array('%recipe' => $recipe['label'] ?? $recipe['name']);
  backdrop_set_message(t($message, $replacements));
}

/**
 * Rollback a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to rollback.
 */
function recipes_rollback_recipe(string $signature) {
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $signature);
  $rollback_config = config($rollback_name);
  if (!$rollback_config->isNew()) {
    $rollback_recipe = $rollback_config->get();

    // Rollback dependencies.
    if (!empty($rollback_recipe['dependencies'])) {
      _recipes_do('rollback', 'dependencies', $signature);
    }

    // Rollback configuration.
    if (!empty($rollback_recipe['config'])) {
      _recipes_do('rollback', 'config', $signature);
    }

    // Rollback overrides.
    if (!empty($rollback_recipe['overrides'])) {
      _recipes_do('rollback', 'overrides', $signature);
    }
  }
  recipes_mark_inactive($signature);
}

/**
 * Implements hook_recipes_action_info().
 */
function recipes_recipes_action_info() {
  $operations = array(
    'inspect' => array(
      'label' => t('View'),
      'callback' => 'recipes_inspect_form',
      'permission' => array('inspect recipes'),
      'file' => 'recipes.actions.inc',
    ),
    'apply' => array(
      'label' => t('Apply'),
      'callback' => 'recipes_apply_form',
      'requirements_callback' => 'recipes_requirements_can_be_applied',
      'permission' => array('manage recipes'),
      'file' => 'recipes.actions.inc',
    ),
    'force' => array(
      'label' => t('Force apply'),
      'callback' => 'recipes_force_apply_form',
      'requirements_callback' => 'recipes_requirements_is_changed',
      'permission' => array('manage recipes'),
      'file' => 'recipes.actions.inc',
    ),
    'detach' => array(
      'label' => t('Detach'),
      'callback' => 'recipes_detach_form',
      'requirements_callback' => 'recipes_requirements_has_been_applied',
      'permission' => array('manage recipes'),
      'file' => 'recipes.actions.inc',
    ),
    'rollback' => array(
      'label' => t('Rollback'),
      'callback' => 'recipes_rollback_form',
      'requirements_callback' => 'recipes_requirements_has_rollback',
      'permission' => array('manage recipes'),
      'file' => 'recipes.actions.inc',
    ),
  );

  return $operations;
}

/**
 * Retrieves a single action's info by its name, or all actions if no name is
 * provided.
 *
 * @param (string) $action
 *   The key of the recipe action to retrieve.
 *
 * @return array|bool
 *   The action info array if found, all actions if no name is provided, or
 *   FALSE if the action does not exist.
 */
function recipes_actions_get_info($action = NULL) {
  $actions = &backdrop_static(__FUNCTION__);

  if (!isset($actions)) {
    $actions = array();
    foreach (module_implements('recipes_action_info') as $module) {
      $all_actions = module_invoke($module, 'recipes_action_info');
      foreach ($all_actions as $action_key => $action_info) {
        $action_info += array(
          'module' => $module,
          'callback' => $action_key . '_form',
          'permission' => 'manage recipes',
          'requirements_callback' => 'recipes_requirements_true',
        );
        $actions[$action_key] = $action_info;
      }
    }
    backdrop_alter('recipes_action_info', $actions);
    // backdrop_sort($actions);
  }

  if (!isset($action)) {
    return $actions;
  }
  elseif (is_array($actions) && isset($actions[$action])) {
    return $actions[$action];
  }
  else {
    return FALSE;
  }
}

/**
 * Default requirements callback, always TRUE.
 */
function recipes_requirements_true() {
  return TRUE;
}

/**
 * Requirements callback: Requires the recipe to be applied. This includes
 * if it was applied and then some dependencies were later changed.
 *
 * @param array $recipe
 *   Recipe implementation array, containing the signature and other metadata.
 *
 * @return bool
 */
function recipes_requirements_has_been_applied(array $recipe) {
  $recipe_status = recipes_get_status($recipe['signature']);
  return ($recipe_status['key'] == RECIPES_STATUS_INSTALLED || $recipe_status['key'] == RECIPES_STATUS_CHANGED);
}

/**
 * Requirements callback: Requires the recipe to have a rollback available.
 *
 * @param array $recipe
 *   Recipe implementation array, containing the signature and other metadata.
 *
 * @return bool
 */
function recipes_requirements_has_rollback(array $recipe) {
  $recipe_status = recipes_get_status($recipe['signature']);
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $recipe['signature']);
  $rollback_config = config($rollback_name);
  return (!$rollback_config->isNew() && ($recipe_status['key'] == RECIPES_STATUS_INSTALLED || $recipe_status['key'] == RECIPES_STATUS_CHANGED));
}

/**
 * Requirements callback: Requires the recipe to not have been applied.
 *
 * @param array $recipe
 *   Recipe implementation array, containing the signature and other metadata.
 *
 * @return bool
 */
function recipes_requirements_has_not_been_applied(array $recipe) {
  $recipe_status = recipes_get_status($recipe['signature']);
  return ($recipe_status['key'] != RECIPES_STATUS_INSTALLED && $recipe_status['key'] != RECIPES_STATUS_CHANGED);
}

/**
 * Requirements callback: Requires the recipe to be applied and have some of the
 * dependencies changed, or to be available but not have been applied yet. This
 * can determine whether the recipe can be applied or re-applied.
 *
 * @param array $recipe
 *   Recipe implementation array, containing the signature and other metadata.
 *
 * @return bool
 */
function recipes_requirements_can_be_applied(array $recipe) {
  $recipe_status = recipes_get_status($recipe['signature']);
  return ($recipe_status['key'] == RECIPES_STATUS_CHANGED || $recipe_status['key'] == RECIPES_STATUS_AVAILABLE);
}

/**
 * Requirements callback: Requires the recipe to be applied and have some of the
 * dependencies changed.
 *
 * @param array $recipe
 *   Recipe implementation array, containing the signature and other metadata.
 *
 * @return bool
 */
function recipes_requirements_is_changed(array $recipe) {
  $recipe_status = recipes_get_status($recipe['signature']);
  return ($recipe_status['key'] == RECIPES_STATUS_CHANGED);
}

/**
 * Set a recipe as installed.
 */
function recipes_mark_active($recipe_signature) {
  $recipes_installed = config('recipes.installed');
  $active_recipes = $recipes_installed->get('active');
  if (!in_array($recipe_signature, $active_recipes)) {
    $active_recipes[$recipe_signature] = time();
    $recipes_installed->set('active', $active_recipes);
    $recipes_installed->save();
  }
}

/**
 * Set a recipe as inactive.
 */
function recipes_mark_inactive($recipe_signature) {
  // Mark the recipe as inactive in the active recipes list.
  $recipes_installed = config('recipes.installed');
  $active_recipes = $recipes_installed->get('active');
  if (isset($active_recipes[$recipe_signature])) {
    unset($active_recipes[$recipe_signature]);
    $recipes_installed->set('active', $active_recipes);
    $recipes_installed->save();
  }
  // Remove the rollback configuration, if any.
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $recipe_signature);
  $rollback_config = config($rollback_name);
  if (!$rollback_config->isNew()) {
    $rollback_config->delete();
  }
}

/**
 * Check whether a recipe is active.
 */
function recipes_is_active($recipe_signature) {
  $active_recipes = config_get('recipes.installed', 'active');
  return isset($active_recipes[$recipe_signature]);
}
