<?php
/**
 * @file
 * Provides functionality and an admin interface for managing recipes.
 */

define ('RECIPES_STATUS_UNAVAILABLE', 'unavailable');
define ('RECIPES_STATUS_AVAILABLE', 'available');
define ('RECIPES_STATUS_INSTALLED', 'installed');
define ('RECIPES_STATUS_CHANGED', 'changed');

include_once backdrop_get_path('module', 'recipes') . '/recipes.helpers.inc';

/**
 * Implements hook_config_info().
 */
function recipes_config_info() {
  $prefixes['recipes.installed'] = array(
    'group' => 'Configuration',
    'label' => t('Recipes installed'),
  );
  $prefixes['recipes.rollback'] = array(
    'name_key' => 'name',
    'label_key' => 'label',
    'group' => t('Rollback recipes'),
  );
  return $prefixes;
}

/**
 * Implements hook_library_info().
 */
function recipes_library_info() {
  $module_path = backdrop_get_path('module', 'recipes');
  $libraries = array();
  $libraries['recipes.admin'] = array(
    'title' => t('Recipes admin'),
    'version' => '1.0',
    'js' => array(
      $module_path . '/js/recipes.admin.js' => array(),
    ),
    'css' => array(
      $module_path . '/css/recipes.admin.css' => array(),
    ),
  );
  return $libraries;
}

/**
 * Implements hook_permission().
 */
function recipes_permission() {
  return array(
    'access recipes overview' => array(
      'title' => t('Access recipes overview'),
      'description' => t('Access the recipes overview page.'),
    ),
    'manage recipes' => array(
      'title' => t('Manage recipes'),
      'description' => t('Enable, Disable, and Revert recipes.'),
      'restrict access' => TRUE,
      'warning' => t('People who can manage recipes will also be able to make changes to sensitive configuration settings and permissions.'),
    ),
    'inspect recipes' => array(
      'title' => t('Inspect recipes'),
      'description' => t('View the technical details and overrides within a recipe without making changes directly.'),
    ),
  );
}

/**
 * Implements hook_menu().
 */
function recipes_menu() {
  $items['admin/structure/recipes'] = array(
    'title' => 'Recipes',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recipes_admin_listing'),
    'access arguments' => array('access recipes overview'),
    'type' => MENU_NORMAL_ITEM,
    'file' => 'recipes.admin.inc',
  );
  $items['admin/structure/recipes/diff/%/%'] = array(
    'title' => 'Configuration diff',
    'page callback' => 'recipes_config_diff_page',
    'page arguments' => array(4, 5),
    'access arguments' => array('inspect recipes'),
    'type' => MENU_LOCAL_TASK,
    'file' => 'recipes.admin.inc',
  );

  // Add a menu callback for each action.
  $actions = recipes_actions_get_info();
  foreach ($actions as $action_key => $action_info) {
    $form_id = $action_info['callback'];
    $items['admin/structure/recipes/' . $action_key . '/%recipes'] = array(
      'title' => 'Recipes ' . $action_info['label'],
      'page callback' => 'backdrop_get_form',
      'page arguments' => array($form_id, 4),
      'access arguments' => $action_info['permission'],
      'type' => MENU_NORMAL_ITEM,
      'file' => $action_info['file'],
    );
  }

  return $items;
}

