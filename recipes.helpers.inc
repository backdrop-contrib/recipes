/**
 * Rollback a recipe's bundled configuration, if it exists.
 *
 * @param string $signature
 *   The signature of the recipe to get the config for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return void
 */
function _recipes_rollback__config(string $signature, array $system_info) {
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $signature);
  $rollback_config = config($rollback_name);
  if (!$rollback_config->isNew()) {
    $rollback_data = $rollback_config->get();
    if (!empty($rollback_data['config'])) {
      backdrop_set_message(t('Automated rollback of bundled configuration is currently available, as the potential for database changes and inconsistencies is high. For now, you can manually remove any fields or other configuration added by the recipe %recipe.', array('%recipe' => $signature)), 'warning');
      // Foreach ($rollback_data['config'] as $config_name => $config_values) {
      //   $config = config($config_name);
      //   if (!$config->isNew()) {
      //     $config->delete();
      //   }
      // }
    }
  }
}

/**
 * Rollback a recipe's dependency changes, if a rollback recipe exists.
 *
 * @param string $signature
 *   The signature of the recipe to rollback dependencies for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return void
 */
function _recipes_rollback__dependencies(string $signature, array $system_info) {
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $signature);
  $rollback_config = config($rollback_name);
  if (!$rollback_config->isNew()) {

    // First, rollback relevant dependencies for the recipe's dependent recipes.
    $rollback_data = $rollback_config->get();
    foreach ($rollback_data['dependencies']['recipe'] as $dependency_name => $dependency_status) {
      if ($dependency_status === FALSE) {
        recipes_rollback_recipe($dependency_name);
      }
    }

    // Rollback dependent modules.
    foreach ($rollback_data['dependencies']['module'] as $module_name => $enabled) {
      if (module_exists($module_name) && !$enabled) {
        module_disable(array($module_name));
      }
    }

    // Rollback dependent themes.
    foreach ($rollback_data['dependencies']['theme'] as $theme_name => $enabled) {
      if (!$enabled) {
        theme_disable(array($theme_name));
      }
      else {
        theme_enable(array($theme_name));
      }
    }

  }
}

/**
 * Rollback a recipe's configuration overrides, if a rollback recipe exists.
 *
 * @param string $signature
 *   The signature of the recipe to rollback overrides for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return void
 */
function _recipes_rollback__overrides(string $signature, array $system_info) {
  $rollback_name = 'recipes.rollback.' . str_replace(':', '.', $signature);
  $rollback_config = config($rollback_name);
  if (!$rollback_config->isNew()) {
    $rollback_data = $rollback_config->get();
    if (!empty($rollback_data['overrides'])) {
      // Config.
      if (!empty($rollback_data['overrides']['config'])) {
        foreach ($rollback_data['overrides']['config'] as $config_name => $config_data) {
          foreach ($config_data as $config_key => $config_value) {
            config_set($config_name, $config_key, $config_value);
          }
        }
      }
      // State.
      if (!empty($rollback_data['overrides']['state'])) {
        foreach ($rollback_data['overrides']['state'] as $state_name => $state_value) {
          state_set($state_name, $state_value);
        }
      }
      // Permissions.
      if (!empty($rollback_data['overrides']['permission'])) {
        foreach ($rollback_data['overrides']['permission'] as $role => $permissions) {
          foreach ($permissions as $permission => $granted) {
            if ($granted) {
              if (!user_role_has_permission($role, $permission)) {
                user_role_grant_permissions($role, array($permission));
              }
            }
            else {
              if (user_role_has_permission($role, $permission)) {
                user_role_revoke_permissions($role, array($permission));
              }
            }
          }
        }
      }
    }
  }
}
