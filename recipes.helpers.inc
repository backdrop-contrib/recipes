<?php
/**
 * @file
 * Helper functions for the Recipes module. These are intended for internal use
 * only and should not be used directly by other modules.
 */

/**
 * Get an array of supported external parts of a recipe such as dependencies
 * and overrides that need to be checked when processing a recipe.
 *
 * @return array
 *   An array of supported external parts of a recipe, including 'dependencies'
 *   and 'overrides'.
 */
function _recipes_parts() {
  return array(
    'config' => array(),
    'dependencies' => array(
      'module',
      'theme',
      'layout_template',
      'recipe',
    ),
    'overrides' => array(
      'config',
      'state',
      'permission',
    ),
  );
}

/**
 * Do something with a part of a recipe.
 *
 * @param string $option
 *   What to perform on the recipe part.
 * @param string $part
 *   The part of the recipe to perform the action on.
 * @param string $signature
 *   The signature of the recipe to get the config for.
 * @param bool $force
 *   Whether to force the action, if applicable.
 *
 * @return array
 *   An array containing the bundled config details of the recipe.
 */
function _recipes_do(string $option, string $part, string $signature) {
  if (!in_array($option, array('get', 'check', 'apply', 'list', 'rollback'))) {
    return array();
  }
  $system_info = _recipes_get_system_info();
  $result = array();
  // Load the recipe data based on the signature.
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return $result;
  }
  $recipe_parts = _recipes_parts();

  if (!isset($recipe_parts[$part]) || !is_array($recipe_parts[$part])) {
    return $result;
  }
  $do_function = '_recipes_' . $option . '__' . $part;
  $result = function_exists($do_function) ? $do_function($signature, $system_info) : array();
  return $result;
}

/**
 * Get the current system status, including enabled and disabled modules and
 * themes and layout templates.
 *
 * @return array
 *   The current system status.
 */
function _recipes_get_system_info() {
  $system_info = &backdrop_static(__FUNCTION__, array());
  if (empty($system_info)) {
    $system_info = array(
      'module' => system_rebuild_module_data(),
      'theme' => list_themes(),
      'layout_template' => layout_get_layout_template_info(),
    );
  }
  return $system_info;
}

/**
 * Get the bundled config details for the 'config' part of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the config for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the bundled config details of the recipe.
 */
function _recipes_get__config(string $signature, array $system_info) {
  $is_rollback = strpos($signature, 'rollback|') === 0;
  $configs = array();
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return $configs;
  }
  $config_path = $recipe['path'] . '/config';
  if (!is_dir($config_path)) {
    // No config directory means there are no bundled configs for this recipe.
    return $configs;
  }
  else {
    $configs['path'] = $config_path;
    $files = array_diff(scandir($config_path), array('..', '.'));
    foreach ($files as $file) {
      $config_name = str_replace('.json', '', $file);
      $configs['names'][] = $config_name;
    }
  }
  return $configs;
}

/**
 * Get details about the various dependencies of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the dependencies for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the dependencies of the recipe.
 */
function _recipes_get__dependencies(string $signature, array $system_info) {
  $dependencies = array();
  $checked = array();
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return $dependencies;
  }
  $dependency_types = _recipes_parts()['dependencies'];
  foreach ($dependency_types as $type) {
    $dependencies[$type] = array();
  }
  $checked[] = $signature;
  if (isset($recipe['dependencies']) && is_array($recipe['dependencies'])) {
    foreach ($recipe['dependencies'] as $dependency_type => $dependencies_list) {
      if (!in_array($dependency_type, $dependency_types)) {
        continue;
      }
      foreach ($dependencies_list as $dependency_name => $dependency_value) {
        $dependencies[$dependency_type][$dependency_name]['value'] = $dependency_value;
        if ($dependency_type == 'recipe' && !in_array($dependency_name, $checked)) {
          $checked[] = $dependency_name;
          $dependencies = array_merge_recursive($dependencies, _recipes_get__dependencies($dependency_name, $system_info));
        }
      }
    }
  }
  return $dependencies;
}

/**
 * Get details about the various overrides of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the overrides for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the overrides of the recipe.
 */
function _recipes_get__overrides(string $signature, array $system_info) {
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return array();
  }
  $overrides = $recipe['overrides'] ?? array();
  return $overrides;
}

/**
 * Check the bundled config details for the 'config' part of a recipe.
 * Generates a status array for bundled config, compared to active config.
 *
 * @param string $signature
 *   The signature of the recipe to get the config for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   Status array for the bundled config files, including the overall status
 *   'key' and any gathered 'messages', along with 'configs' keyed by config
 *   name, with values indicating the status of each config file.
 *     - 'new': The config file is new and would be imported if the recipe was applied.
 *     - 'changed': The config file exists and has changes.
 *     - 'matches': The config file exists and matches the active configuration.
 */
function _recipes_check__config(string $signature, array $system_info) {
  $status = array(
    'key' => RECIPES_STATUS_AVAILABLE,
    'messages' => array(),
    'configs' => array(),
  );
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    $status['key'] = RECIPES_STATUS_UNAVAILABLE;
    return $status;
  }
  $configs = _recipes_do('get', 'config', $signature);
  if (empty($configs['names'])) {
    return $status;
  }
  else {
    foreach ($configs['names'] as $config_name) {
      $file = $config_name . '.json';
      $config = config($config_name);
      if ($config->isNew()) {
        $status['configs'][$config_name] = 'new';
      }
      else {
        // Load the recipe's bundled config for comparison if needed.
        $bundled_config = json_decode(file_get_contents($configs['path'] . '/' . $file), TRUE);
        $active_config = $config->get();
        unset($bundled_config['_config_name']);
        if ($bundled_config !== $active_config) {
          $status['configs'][$config_name] = 'changed';
        }
        else {
          $status['configs'][$config_name] = 'matches';
        }
      }
    }
  }
  if (recipes_is_active($recipe['signature']) && in_array('new', $status['configs'])) {
    $status['key'] = RECIPES_STATUS_CHANGED;
    $status['messages'][] = t('The recipe was installed but some of the bundled configuration files are not present.');
  }
  elseif (recipes_is_active($recipe['signature']) && in_array('changed', $status['configs'])) {
    $status['key'] = RECIPES_STATUS_CHANGED;
    $status['messages'][] = t('The recipe was installed but some of the bundled configuration files have changed.');
  }

  return $status;
}

/**
 * Check the module dependencies of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the module dependencies for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the module dependencies of the recipe.
 */
function _recipes_check__dependencies(string $signature, array $system_info) {
  $system_info['recipe'] = recipes_load_multiple(array(), $system_info);
  $status = array(
    'key' => RECIPES_STATUS_AVAILABLE,
    'messages' => array(),
  );
  $dependencies = _recipes_do('get', 'dependencies', $signature);
  $status['dependencies'] = $dependencies;
  $dependency_types = _recipes_parts()['dependencies'];
  // Check if the recipe is installed.
  $recipe_is_active = recipes_is_active($signature);
  foreach ($dependency_types as $type) {
    if (!empty($dependencies[$type])) {
      foreach ($dependencies[$type] as $dependency_key => $dependency_data) {
        if ($dependency_data['value'] != TRUE) {
          break;
        }
        // Check if needed dependencies exist.
        if (!isset($system_info[$type][$dependency_key])) {
          $status['key'] = RECIPES_STATUS_UNAVAILABLE;
          $status['messages'][] = t('Dependency %dependency (@type) is not met.', array('%dependency' => $dependency_key, '@type' => $type));
        }
        elseif ((in_array($type, ["module", "theme"]) && empty($system_info[$type][$dependency_key]->status))
          && $recipe_is_active) {
          $status['key'] = RECIPES_STATUS_CHANGED;
          $status['messages'][] = t('Dependency %dependency (@type) has changed.', array('%dependency' => $dependency_key, '@type' => $type));
        }
        elseif ($type == "recipe" && $recipe_is_active) {
          $sub_recipes_status = $system_info[$type][$dependency_key]['status'] ?? NULL;
          if ($sub_recipes_status && $sub_recipes_status['key'] != RECIPES_STATUS_INSTALLED) {
            $status['key'] = RECIPES_STATUS_CHANGED;
            $status['messages'][] = t('Dependency %dependency (@type) has changed.', array('%dependency' => $dependency_key, '@type' => $type));
          }
        }
      }
    }
  }
  return $status;
}

/**
 * Check the various overrides of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the overrides for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the overrides of the recipe.
 */
function _recipes_check__overrides(string $signature, array $system_info) {
  $status = array(
    'key' => RECIPES_STATUS_AVAILABLE,
    'messages' => array(),
  );
  $overrides = _recipes_do('get', 'overrides', $signature);
  if (empty($overrides)) {
    return $status;
  }
  // Config.
  if (!empty($overrides['config'])) {
    foreach ($overrides['config'] as $config_name => $config_data) {
      foreach ($config_data as $config_key => $config_value) {
        $current_value = config_get($config_name, $config_key);
        if ($current_value !== $config_value) {
          $status['key'] = RECIPES_STATUS_CHANGED;
          $status['messages'][] = t('Configuration %config_key for %config_name has changed.', array('%config_key' => $config_key, '%config_name' => $config_name));
        }
      }
    }
  }
  // State.
  if (!empty($overrides['state'])) {
    foreach ($overrides['state'] as $state_name => $state_value) {
      $current_value = state_get($state_name);
      if ($current_value !== $state_value) {
        $status['key'] = RECIPES_STATUS_CHANGED;
        $status['messages'][] = t('State %state_name has changed.', array('%state_name' => $state_name));
      }
    }
  }

  // Permissions.
  if (!empty($overrides['permission'])) {
    foreach ($overrides['permission'] as $role => $permissions) {
      foreach ($permissions as $permission => $granted) {
        $current_granted = user_role_has_permission($role, $permission);
        if ($current_granted !== $granted) {
          $status['key'] = RECIPES_STATUS_CHANGED;
          $status['messages'][] = t('Permission %permission for role %role has changed.', array('%permission' => $permission, '%role' => $role));
        }
      }
    }
  }
  return $status;
}

/**
 * Import a recipe's bundled configuration. If configuration files already
 * exist, they will be skipped with a warning message by default.
 *
 * @param string $signature
 *   The signature of the recipe to get the config for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the rollback information for the bundled config details
 *   of the recipe.
 */
function _recipes_apply__config(string $signature, array $system_info, bool $force = FALSE) {
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return array();
  }
  $config_path = $recipe['path'] . '/config';
  if (!is_dir($config_path)) {
    return array();
  }
  if (!is_readable($config_path)) {
    return array();
  }
  // Scan for .json files.
  $config_files = glob($config_path . '/*.json');
  if ($config_files === FALSE) {
    return array();
  }
  $rollback_info = array();
  $import_config_names = array();
  foreach ($config_files as $config_file) {
    if (is_readable($config_file)) {
      $parts = explode('/', $config_file);
      $file = array_pop($parts);
      $import_config_names[] = str_replace('.json', '', $file);
    }
  }
  $storage = new ConfigFileStorage($config_path);

  foreach ($import_config_names as $import_config_name) {
    // Load config data into the active store and write it out to the
    // file system in the Backdrop config directory. Note the config name
    // needs to be the same as the file name WITHOUT the extension.
    if (!empty($import_config_name)) {
      $data = $storage->read($import_config_name);
      $config = config($import_config_name);
      // We only create new configs, and do not overwrite existing ones unless
      // $force is TRUE.
      if ($config->isNew() || $force) {
        if ($config->isNew()) {
          $rollback_info[$import_config_name] = FALSE;
        }
        else {
          $rollback_info[$import_config_name] = $config->get();
        }
        $config->setData($data);
        module_invoke_all('config_create', $config);
        $config->save();
      }
    }
  }
  return $rollback_info;
}

/**
 * Apply the various dependencies of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to apply the dependencies for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 * @param array $recipes_applied
 *   An array keeping track of recipes that have already been applied to avoid
 *   recursion.
 *
 * @return array
 *   An array containing rollback information for the various dependencies that
 *   were applied for the recipe.
 */
function _recipes_apply__dependencies(string $signature, array $system_info, array $recipes_applied = array()) {
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return array();
  }
  $rollback_info = array();

  // First, apply dependencies for the recipe's dependent recipes.
  foreach ($recipe['dependencies']['recipe'] as $dependency_name => $dependency_status) {
    $currently_active = recipes_is_active($dependency_name);
    if ($dependency_status === TRUE && !isset($recipes_applied[$dependency_name]) && !$currently_active) {
      $recipes_applied[$dependency_name] = TRUE;
      $rollback_info['recipe'][$dependency_name] = $currently_active;
      recipes_apply_recipe($dependency_name);
    }
  }

  // Enable dependent modules.
  foreach ($recipe['dependencies']['module'] as $module_name => $enabled) {
    if (!module_exists($module_name) && $enabled) {
      module_enable(array($module_name), TRUE);
      $rollback_info['module'][$module_name] = FALSE;
    }
  }

  // Enable dependent themes.
  foreach ($recipe['dependencies']['theme'] as $theme_name => $enabled) {
    if (!theme_get_setting('theme', $theme_name) && $enabled) {
      theme_enable(array($theme_name));
      $rollback_info['theme'][$theme_name] = FALSE;
    }
  }

  return $rollback_info;
}

/**
 * Apply the various overrides of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the overrides for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the rollback information for the overrides of the
 *   recipe.
 */
function _recipes_apply__overrides(string $signature, array $system_info) {
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return array();
  }
  if (empty($recipe['overrides'])) {
    return array();
  }
  $rollback_info = array();
  // Config.
  if (!empty($recipe['overrides']['config'])) {
    foreach ($recipe['overrides']['config'] as $config_name => $config_data) {
      foreach ($config_data as $config_key => $config_value) {
        $rollback_info['config'][$config_name][$config_key] = config_get($config_name, $config_key);
        config_set($config_name, $config_key, $config_value);
      }
    }
  }
  // State.
  if (!empty($recipe['overrides']['state'])) {
    foreach ($recipe['overrides']['state'] as $state_name => $state_value) {
      $rollback_info['state'][$state_name] = state_get($state_name);
      state_set($state_name, $state_value);
    }
  }

  // Permissions.
  if (!empty($recipe['overrides']['permission'])) {
    foreach ($recipe['overrides']['permission'] as $role => $permissions) {
      foreach ($permissions as $permission => $granted) {
        if ($granted) {
          if (!user_role_has_permission($role, $permission)) {
            $rollback_info['permission'][$role][$permission] = FALSE;
            user_role_grant_permissions($role, array($permission));
          }
        }
        else {
          if (user_role_has_permission($role, $permission)) {
            $rollback_info['permission'][$role][$permission] = TRUE;
            user_role_revoke_permissions($role, array($permission));
          }
        }
      }
    }
  }
  return $rollback_info;
}

/**
 * List the bundled config details for the 'config' part of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the config for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return array
 *   An array containing the bundled config details of the recipe.
 */
function _recipes_list__config(string $signature, array $system_info) {
  $is_rollback = strpos($signature, 'rollback|') === 0;
  $markup = '';
  $headers = array();
  $rows = array();
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe)) {
    return array();
  }
  $recipe_status = recipes_get_status($recipe['signature']);
  $config_status = _recipes_do('check', 'config', $recipe['signature']);
  if (empty($config_status['configs']) && !$is_rollback) {
    $markup .= '<p>' . t('No configuration files found for this recipe.') . '</p>';
  }
  else {
    $dependency_global_status = TRUE;
    foreach ($config_status['configs'] as $config_name => $status_value) {
      $class = array();
      if ($status_value == 'new') {
        $class[] = 'report-warning';
        $status = t('Will be imported');
        $title = t('New');
      }
      elseif ($status_value == 'matches') {
        $class[] = 'report-status';
        $status = t('Exists and matches');
        $title = t('Ok');
      }
      elseif ($status_value == 'changed') {
        $class[] = 'report-warning';
        $status = _recipes_diff_link_markup($recipe['signature'], $config_name);
        // $status = t('Exists but does not match');
        $title = t('Warning');
        $dependency_global_status = FALSE;
      }
      else {
        $class[] = 'report-warning';
        $status = t('Already exists, will be skipped');
        $title = t('Warning');
        $dependency_global_status = FALSE;
      }
      $row_icon = array(
        'data' => '<div title="' . $title . '"><span class="element-invisible">' . $title . '</span></div>',
        'class' => 'report-icon',
      );
      $row_data = array(
        'data' => '<div class="recipe-inspect--info">' . $config_name . '</div><div class="recipe-inspect--status">' . $status . '</div>',
        'class' => 'recipe-inspect',
      );
      $rows[] = array(
        'data' => array($row_icon, $row_data),
        'class' => $class,
      );
    }

    $use_details_wrapper = count($config_status['configs']) > 3;
    if ($use_details_wrapper) {
      if (!$dependency_global_status) {
        $markup .= '<details open>';
      }
      else {
        $markup .= '<details>';
      }
      $markup .= '<summary>' . t('Configuration files (' . count($config_status['configs']) . ')') . '</summary>';
    }
    $markup .= theme('table', array(
      'header' => $headers,
      'rows' => $rows,
    ));
    if ($use_details_wrapper) {
      $markup .= '</details>';
    }
  }

  return $markup;
}

/**
 * List markup for the various dependencies of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the dependencies for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return string
 *   Markup containing the dependencies of the recipe.
 */
function _recipes_list__dependencies(string $signature, array $system_info) {
  $dependency_types = _recipes_parts()['dependencies'];
  $markup = '';
  foreach ($dependency_types as $dependency_type) {
    $dependency_type_function = '_recipes_list__dependencies__' . $dependency_type;
    if (function_exists($dependency_type_function)) {
      $markup .= $dependency_type_function($signature, $system_info);
    }
  }
  return $markup;
}

/**
 * List the various overrides of a recipe.
 *
 * @param string $signature
 *   The signature of the recipe to get the overrides for.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return string
 *   Markup containing the overrides of the recipe.
 */
function _recipes_list__overrides(string $signature, array $system_info) {
  $is_rollback = strpos($signature, 'rollback|') === 0;
  $item = $is_rollback ? 'Previous value' : 'Recipe';
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe['overrides'])) {
    $markup .= '<p>' . t('No overrides found.') . '</p>';
  }
  else {
    $overrides = $recipe['overrides'];
    $headers = array();
    // Config overrides.
    if (!empty($overrides['config'])) {
      $markup .= '<h4>' . t('Configuration') . '</h4>';
      $rows = array();
      foreach ($overrides['config'] as $config_name => $config_setting) {
        foreach ($config_setting as $config_key => $needed_value) {
          $current_value = config_get($config_name, $config_key) ?? t('[empty]');
          $row_class = ($current_value == $needed_value) ? 'report-status' : 'report-warning';
          $rows[] = array(
            'data' => array(
              array(
                'data' => '<div class="' . $row_class . '"><span class="element-invisible">' . $row_class . '</span></div>',
                'class' => 'report-icon',
              ),
              array(
                'data' => '<div class="recipe-inspect--info">' . $config_name . ':' . $config_key . '</div><div class="recipe-inspect--status">' . $current_value . icon('arrow-right') . $needed_value . '</div>',
                'class' => 'recipe-inspect',
              ),
            ),
            'class' => array($row_class),
          );
        }
      }
      $markup .= theme('table', array('header' => $headers, 'rows' => $rows));
    }
    // State overrides.
    if (!empty($overrides['state'])) {
      $markup .= '<h4>' . t('State') . '</h4>';
      $rows = array();
      foreach ($overrides['state'] as $state_name => $needed_value) {
        $current_value = state_get($state_name);
        $row_class = ($current_value == $needed_value) ? 'report-status' : 'report-warning';
        if (!is_array($needed_value) && !is_array($current_value)) {
          $current_value = check_plain($current_value ?? t('[empty]'));
          $needed_value = check_plain($needed_value);
          $comparison = $current_value . icon('arrow-right') . $needed_value;
        }
        else {
          $comparison = t('Complex value can\'t be shown here.');
        }
        $rows[] = array(
          'data' => array(
            array(
              'data' => '<div class="' . $row_class . '"><span class="element-invisible">' . $row_class . '</span></div>',
              'class' => 'report-icon',
            ),
            array(
              'data' => '<div class="recipe-inspect--info">' . $state_name . '</div><div class="recipe-inspect--status">' . $comparison . '</div>',
              'class' => 'recipe-inspect',
            ),
          ),
          'class' => array($row_class),
        );
      }
      $markup .= theme('table', array('header' => $headers, 'rows' => $rows));
    }
    // Permission overrides.
    if (!empty($overrides['permission'])) {
      $markup .= '<h4>' . t('Permission') . '</h4>';
      $rows = array();
      $invalid = array();
      $icons = array(
        'override-granted' => 'check',
        'override-denied' => 'x',
        'already-granted' => 'check',
        'already-denied' => 'x',
        'info-granted' => 'check',
        'info-denied' => 'x',
      );
      $labels = array(
        'override-granted' => t('@item grants this permission (site currently does not grant it)', array('@item' => $item)),
        'override-denied' => t('@item denies this permission (site currently grants it)', array('@item' => $item)),
        'already-granted' => t('@item and site both grant this permission', array('@item' => $item)),
        'already-denied' => t('@item and site both deny this permission', array('@item' => $item)),
        'info-granted' => t('Unchanged (site grants this permission)'),
        'info-denied' => t('Unchanged (site denies this permission)'),
      );
      // Recreate user_permission_get_modules() to pull additional information.
      $valid_permissions = array();
      $module_perms = array();
      foreach (module_implements('permission') as $module) {
        $module_enabled = !empty($system_info['module'][$module]->status);
        if ($module_enabled && empty($module_perms[$module])) {
          $perms = module_invoke($module, 'permission');
        }
        else {
          $perms = $module_perms[$module];
        }
        foreach ($perms as $key => $value) {
          $valid_permissions[$key] = array(
            'module' => $module,
            'label' => check_plain($value['title']),
            'description' => isset($value['description']) ? filter_xss_admin($value['description']) : '',
            'restrict access' => isset($value['restrict access']) ? (bool) $value['restrict access'] : FALSE,
            'warning' => isset($value['warning']) ? filter_xss_admin($value['warning']) : '',
          );
          $module_perms[$module][$key] = $valid_permissions[$key];
        }
      }

      $roles = user_roles(FALSE, NULL, TRUE);
      $headers = array(
        t('Permission'),
      );
      foreach ($roles as $role_name => $role_object) {
        $headers[] = t($role_object->label);
      }
      $matrix = array();
      $permission_defaults_added = array();
      foreach ($overrides['permission'] as $override_role_name => $needed_permissions) {
        foreach ($needed_permissions as $permission_name => $needed_value) {
          if (!isset($valid_permissions[$permission_name])) {
            $invalid[] = $permission_name;
            continue;
          }
          // Populate defaults.
          if (!isset($permission_defaults_added[$module_name][$permission_name])) {
            $module_name = $valid_permissions[$permission_name]['module'];
            foreach ($roles as $role_name => $role_object) {
              $current_value = in_array($permission_name, $role_object->permissions);
              $matrix[$module_name][$permission_name][$role_name] = $current_value ? 'info-granted' : 'info-denied';
            }
            $permission_defaults_added[$module_name][$permission_name] = TRUE;
          }
          // Populate overrides.
          $current_value = in_array($permission_name, $roles[$override_role_name]->permissions);
          if ((int) $current_value != (int) $needed_value) {
            $matrix[$module_name][$permission_name][$override_role_name] = ($needed_value) ? 'override-granted' : 'override-denied';
          }
          else {
            $matrix[$module_name][$permission_name][$override_role_name] = ($needed_value) ? 'already-granted' : 'already-denied';
          }
        }
      }
      foreach ($matrix as $module_name => $module_permissions) {
        $module_label = $system_info['module'][$module_name]->info['name'] ?? $module_name;
        $rows[] = array(
          'data' => array(
            array(
              'data' => '<div class="recipe-inspect--module">' . $module_label . '</div>',
              'class' => 'module',
              'colspan' => count($headers),
            ),
          ),
          'class' => array('module-row'),
        );

        foreach ($module_permissions as $permission_name => $role_statuses) {
          $permission_description = '<div class="recipe-inspect--info">';
          $permission_description .= theme('label_machine_name__recipe', array(
            'label' => $valid_permissions[$permission_name]['label'],
            'machine_name' => $permission_name,
          ));
          if (!empty($valid_permissions[$permission_name]['warning'])) {
            $permission_description .= '<div class="requirements">';
            $permission_description .= theme('user_permission_description', array(
              'permission_item' => $valid_permissions[$permission_name],
            ));
            $permission_description .= '</div>';
          }
          $permission_description .= '</div>';
          $new_row = array(
            'data' => array(
              array(
                'data' => $permission_description,
                'class' => 'recipe-inspect',
              ),
            ),
          );
          foreach ($role_statuses as $matrix_role_name => $role_status) {
            $new_row['data'][] = array(
              'data' => icon($icons[$role_status], ['alt' => $labels[$role_status]]),
              'class' => ['recipe-permissions', 'recipe-permissions--' . $role_status],
            );
          }
          $rows[] = $new_row;
        }
      }
      $markup .= theme('table', array(
        'header' => $headers,
        'rows' => $rows,
        'attributes' => array('id' => 'permissions'),
      ));
      if (!empty($invalid)) {
        $markup .= '<p>' . t('Invalid permissions which will be skipped: @permissions', array('@permissions' => implode(', ', $invalid))) . '</p>';
      }
    }
  }

  return $markup;
}

/**
 * List recipe dependencies for a given recipe signature.
 */
function _recipes_list__dependencies__recipe(string $signature, array $system_info) {
  $headers = array();
  $rows = array();
  $markup = '<h4>' . t('Recipes') . '</h4>';
  $recipe = recipes_load($signature, $system_info);
  if (empty($recipe['dependencies']['recipe'])) {
    $markup .= '<p>' . t('No recipe dependencies found.') . '</p>';
  }
  else {
    $recipes = $recipe['dependencies']['recipe'];

    foreach ($recipes as $recipe_name => $needed_active) {
      $recipe_status = recipes_get_status($recipe_name);
      $is_present = $recipe_status['key'] != RECIPES_STATUS_UNAVAILABLE;
      $sub_dependency_status = recipes_get_status($recipe_name);
      $class = [];
      if ($needed_active && !$is_present) {
        $class[] = 'report-error';
        $status = t('Not available');
        $title = t('Error');
      }
      elseif ($needed_active && $is_present && $sub_dependency_status['key'] == RECIPES_STATUS_UNAVAILABLE) {
        $class[] = 'report-error';
        $status = t('Dependent recipe is available but sub-dependencies are not met');
        $title = t('Error');
      }
      elseif ($needed_active && $is_present && $sub_dependency_status['key'] == RECIPES_STATUS_CHANGED) {
        $class[] = 'report-warning';
        $status = t('Dependent recipe is already applied, but has changed from defaults');
        $title = t('Warning');
      }
      elseif (!$needed_active && $is_present && ($sub_dependency_status['key'] == RECIPES_STATUS_CHANGED || $sub_dependency_status['key'] == RECIPES_STATUS_INSTALLED)) {
        $class[] = 'report-error';
        $status = t('Dependent recipe is currently applied and will be rolled back');
        $title = t('Error');
      }
      elseif ($needed_active && $is_present && $sub_dependency_status['key'] == RECIPES_STATUS_INSTALLED) {
        $class[] = 'report-status';
        $status = t('Dependent recipe is installed and up to date');
        $title = t('Ok');
      }
      else {
        $class[] = 'report-status';
        $status = t('Available');
        $title = t('Ok');
      }
      $row_icon = array(
        'data' => '<div title="' . $title . '"><span class="element-invisible">' . $title . '</span></div>',
        'class' => 'report-icon',
      );
      $row_data = array(
        'data' => '<div class="recipe-inspect--info">' . $recipe_name . '</div><div class="recipe-inspect--status">' . $status . '</div>',
        'class' => 'recipe-inspect',
      );
      $rows[] = array(
        'data' => array($row_icon, $row_data),
        'class' => $class,
      );
    }

    $markup .= theme('table', array('header' => $headers, 'rows' => $rows));
  }

  return $markup;
}

/**
 * List recipe module dependencies for a given recipe signature.
 *
 * @param string $signature
 *   The recipe signature.
 * @param array $system_info
 *   An array containing system information as generated by
 *   _recipes_get_system_info().
 *
 * @return string
 *   Markup containing the module dependencies of the recipe.
 */
function _recipes_list__dependencies__module(string $signature, array $system_info) {
  $recipe = recipes_load($signature);
  $markup = '<h4>' . t('Modules') . '</h4>';
  $headers = array();
  $rows = array();
  if (empty($recipe['dependencies']['module'])) {
    $markup .= '<p>' . t('No module dependencies found.') . '</p>';
  }
  else {
    $modules = $recipe['dependencies']['module'];

    foreach ($modules as $module_name => $needed_active) {
      $is_present = isset($system_info['module'][$module_name]);
      $currently_active = $is_present && $system_info['module'][$module_name]->status;
      $class = [];
      if ($needed_active && !$currently_active && $is_present) {
        $class[] = 'report-warning';
        $status = t('Will be enabled');
        $title = t('New');
      }
      elseif (!$needed_active && $currently_active) {
        $class[] = 'report-error';
        $status = t('Must be disabled before applying');
        $title = t('Error');
      }
      elseif ($needed_active && $currently_active) {
        $class[] = 'report-status';
        $status = t('Already enabled');
        $title = t('Ok');
      }
      elseif (!$needed_active && !$currently_active) {
        $class[] = 'report-status';
        $status = t('Already disabled');
        $title = t('Ok');
      }
      elseif ($needed_active && !$is_present) {
        $class[] = 'report-error';
        $status = t('Not available');
        $title = t('Error');
      }
      $row_icon = array(
        'data' => '<div title="' . $title . '"><span class="element-invisible">' . $title . '</span></div>',
        'class' => 'report-icon',
      );
      $row_data = array(
        'data' => '<div class="recipe-inspect--info">' . $module_name . '</div><div class="recipe-inspect--status">' . $status . '</div>',
        'class' => 'recipe-inspect',
      );
      $rows[] = array(
        'data' => array($row_icon, $row_data),
        'class' => $class,
      );
    }

    $markup .= theme('table', array('header' => $headers, 'rows' => $rows));
  }

  return $markup;
}

